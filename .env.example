# ---- ProofPatch engine / API settings ----
PROOFPATCH_DATA_DIR=.proofpatch
PROOFPATCH_DATABASE_URL=sqlite:///./.proofpatch/proofpatch.db
PROOFPATCH_KEEP_WORKTREES=0
PROOFPATCH_DEFAULT_TIMEOUT=120
PROOFPATCH_MAX_PATCH_FILES=8
PROOFPATCH_MAX_PATCH_LINES=400

# ---- Cline SDK (the only LLM integration) ----
PROOFPATCH_CLINE_PROVIDER_ID=cline
# Optional: override the auto-discovered Cline account model.
# PROOFPATCH_CLINE_MODEL_ID=
# Optional: override the auto-discovered Cline credentials from ~/.cline.
# PROOFPATCH_CLINE_API_KEY=
# Optional: custom endpoint for OpenAI-compatible providers behind the SDK.
# PROOFPATCH_CLINE_BASE_URL=
PROOFPATCH_CLINE_NODE_BIN=node
# Optional: override the bridge directory (auto-resolved to packages/cline-bridge).
# PROOFPATCH_CLINE_BRIDGE_DIR=
PROOFPATCH_CLINE_TIMEOUT_SECONDS=180
PROOFPATCH_CLINE_MAX_ITERATIONS=1
PROOFPATCH_CLINE_MAX_RETRIES=1
